model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Audit Columns
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  // Self-referencing relations
  creator      User?  @relation("UserCreator", fields: [createdBy], references: [id])
  updater      User?  @relation("UserUpdater", fields: [updatedBy], references: [id])
  createdUsers User[] @relation("UserCreator")
  updatedUsers User[] @relation("UserUpdater")

  // Relations
  platformUser          PlatformUser?
  // why this as array
  organisationUsers     OrganisationUser?
  platformUserRoles     PlatformUserRole[]
  organisationUserRoles OrganisationUserRole[] @relation("OrgUserRoleOwner")

  // Platform RBAC Audit Relations
  createdPlatformRoles       PlatformRole[]           @relation("PlatformRoleCreator")
  updatedPlatformRoles       PlatformRole[]           @relation("PlatformRoleUpdater")
  createdPlatformPermissions PlatformPermission[]     @relation("PlatformPermissionCreator")
  updatedPlatformPermissions PlatformPermission[]     @relation("PlatformPermissionUpdater")
  createdPlatformUserRoles   PlatformUserRole[]       @relation("PlatformUserRoleCreator")
  createdPlatformRP          PlatformRolePermission[] @relation("PlatformRPCreator")

  // Organisation RBAC Audit Relations
  createdOrganisations  Organisation[]               @relation("OrgCreator")
  updatedOrganisations  Organisation[]               @relation("OrgUpdater")
  createdOrgRoles       OrganisationRole[]           @relation("OrgRoleCreator")
  updatedOrgRoles       OrganisationRole[]           @relation("OrgRoleUpdater")
  createdOrgPermissions OrganisationPermission[]     @relation("OrgPermCreator")
  updatedOrgPermissions OrganisationPermission[]     @relation("OrgPermUpdater")
  createdOrgUserRoles   OrganisationUserRole[]       @relation("OrgUserRoleCreator")
  createdOrgRP          OrganisationRolePermission[] @relation("OrgRPCreator")

  platformAuditLogs     PlatformAuditLog[]
  organisationAuditLogs OrganisationAuditLog[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// PLATFORM LEVEL (RBAC)
// -----------------------------------------------------------------------------

model PlatformUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  status      Int       @map("status")@default(1)
  cognitoSub  String    @unique @map("cognito_sub") @db.Uuid
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  // status EntityOption @relation("UserStatus", fields: [statusId], references: [id])

  @@map("platform_users")
}

model PlatformRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  creator         User                     @relation("PlatformRoleCreator", fields: [createdBy], references: [id])
  updater         User?                    @relation("PlatformRoleUpdater", fields: [updatedBy], references: [id])
  rolePermissions PlatformRolePermission[]
  userRoles       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformPermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid

  creator         User?                    @relation("PlatformPermissionCreator", fields: [createdBy], references: [id])
  updater         User?                    @relation("PlatformPermissionUpdater", fields: [updatedBy], references: [id])
  rolePermissions PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformRolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       PlatformRole       @relation(fields: [roleId], references: [id])
  permission PlatformPermission @relation(fields: [permissionId], references: [id])
  creator    User               @relation("PlatformRPCreator", fields: [createdBy], references: [id])

  @@unique([roleId, permissionId])
  @@map("platform_role_permissions")
}

model PlatformUserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id])
  role    PlatformRole @relation(fields: [roleId], references: [id])
  creator User         @relation("PlatformUserRoleCreator", fields: [createdBy], references: [id])

  @@unique([userId, roleId])
  @@map("platform_user_roles")
}

// -----------------------------------------------------------------------------
// ORGANISATION LEVEL (Multi-tenant)
// -----------------------------------------------------------------------------

model Organisation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber String   @unique @map("reference_number") @db.VarChar(50)
  name            String   @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  status          Int  @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  creator User? @relation("OrgCreator", fields: [createdBy], references: [id])
  updater User? @relation("OrgUpdater", fields: [updatedBy], references: [id])

  roles       OrganisationRole[]
  permissions OrganisationPermission[]
  userRoles   OrganisationUserRole[]
  auditLogs   OrganisationAuditLog[]

  @@map("organisations")
}

model OrganisationUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  status      Int       @map("status")@default(2)
  cognitoSub  String    @unique @map("cognito_sub") @db.Uuid
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  // status EntityOption @relation("OrgUserStatus", fields: [statusId], references: [id])

  @@map("organisation_users")
}

model OrganisationRole {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  name           String   @unique @db.VarChar(50)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation    Organisation?                @relation(fields: [organisationId], references: [id])
  creator         User                         @relation("OrgRoleCreator", fields: [createdBy], references: [id])
  updater         User?                        @relation("OrgRoleUpdater", fields: [updatedBy], references: [id])
  rolePermissions OrganisationRolePermission[]
  userRoles       OrganisationUserRole[]

  @@map("organisation_roles")
}

model OrganisationPermission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  name           String   @unique @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid

  organisation    Organisation?                @relation(fields: [organisationId], references: [id])
  updater         User?                        @relation("OrgPermUpdater", fields: [updatedBy], references: [id])
  creator         User?                        @relation("OrgPermCreator", fields: [createdBy], references: [id])
  rolePermissions OrganisationRolePermission[]

  @@map("organisation_permissions")
}

model OrganisationRolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       OrganisationRole       @relation(fields: [roleId], references: [id])
  permission OrganisationPermission @relation(fields: [permissionId], references: [id])
  creator    User?                  @relation("OrgRPCreator", fields: [createdBy], references: [id])

  @@unique([roleId, permissionId])
  @@map("organisation_role_permissions")
}

model OrganisationUserRole {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  user         User             @relation("OrgUserRoleOwner", fields: [userId], references: [id])
  role         OrganisationRole @relation(fields: [roleId], references: [id])
  creator      User             @relation("OrgUserRoleCreator", fields: [createdBy], references: [id])

  @@map("organisation_user_roles")
}

model OrganisationAuditLog {
  id             Int      @id @default(autoincrement())
  organisationId String?  @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  action         String   @db.VarChar(255)
  details        String
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@map("organisation_audit_logs")
}

model PlatformAuditLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(255)
  details   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("platfrom_audit_logs")
}
